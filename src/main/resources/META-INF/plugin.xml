<idea-plugin>
  <id>com.github.jclsn.codesonar</id>
  <name>CodeSonar</name>
  <vendor url="https://github.com/jclsn">Jan Claußen</vendor>

  <description><![CDATA[
    CodeSonar warnings in CLion, from a CodeSonar hub or an exported SARIF
    file. The work is done by the
    <a href="https://github.com/jclsn/codesonar-lsp">codesonar-lsp</a>
    language server, which must be installed.
    <ul>
      <li>choose, show, hide and delete the analyses of the hub project</li>
      <li>explain warnings with the events that lead to them and the rules
          they may violate</li>
      <li>run <code>codesonar analyze</code> for the workspace, with the hub,
          project, presets and checks of its <code>codesonar.conf</code></li>
      <li>list the shown warnings and open them on the hub</li>
    </ul>
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lsp</depends>

  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider
        implementation="com.github.jclsn.codesonar.lsp.CodeSonarLspIntegrationProvider"/>
    <notificationGroup id="CodeSonar" displayType="BALLOON"/>
    <applicationConfigurable
        parentId="tools"
        id="com.github.jclsn.codesonar.settings"
        displayName="CodeSonar"
        instance="com.github.jclsn.codesonar.settings.CodeSonarConfigurable"/>
    <statusBarWidgetFactory
        id="CodeSonar"
        implementation="com.github.jclsn.codesonar.ui.CodeSonarStatusBarWidgetFactory"/>
    <toolWindow
        id="CodeSonar"
        anchor="bottom"
        icon="AllIcons.Toolwindows.ToolWindowProblemsEmpty"
        doNotActivateOnStart="true"
        factoryClass="com.github.jclsn.codesonar.ui.WarningsToolWindowFactory"/>
  </extensions>

  <actions>
    <group id="CodeSonar.Actions">
      <action id="CodeSonar.Analyses" class="com.github.jclsn.codesonar.actions.AnalysesAction"
              text="Analyses..."
              description="Choose, show, hide and delete the analyses of the hub project"/>
      <action id="CodeSonar.Load" class="com.github.jclsn.codesonar.actions.LoadAction"
              text="Load Configured Analysis"
              description="Show the configured analysis"/>
      <action id="CodeSonar.LoadSarif" class="com.github.jclsn.codesonar.actions.LoadSarifAction"
              text="Load SARIF File..."
              description="Show the warnings of an exported SARIF file"/>
      <action id="CodeSonar.Refresh" class="com.github.jclsn.codesonar.actions.RefreshAction"
              text="Refresh"
              description="Load the shown analysis again"/>
      <action id="CodeSonar.Hide" class="com.github.jclsn.codesonar.actions.HideAction"
              text="Hide Analysis"
              description="Turn the shown analysis off until an analysis is shown again"/>
      <separator/>
      <action id="CodeSonar.Explain" class="com.github.jclsn.codesonar.actions.ExplainAction"
              text="Explain Warning"
              description="Explain the warnings in the line of the caret"/>
      <action id="CodeSonar.OpenHub" class="com.github.jclsn.codesonar.actions.OpenHubAction"
              text="Open in Hub"
              description="Open the warning at the caret on the hub, or else the shown analysis"/>
      <action id="CodeSonar.ResolveFixed" class="com.github.jclsn.codesonar.actions.ResolveFixedAction"
              text="Mark as Fixed"
              description="Mark the warnings in the line of the caret as fixed on the hub"/>
      <action id="CodeSonar.ResolveFalsePositive"
              class="com.github.jclsn.codesonar.actions.ResolveFalsePositiveAction"
              text="Mark as False Positive"
              description="Mark the warnings in the line of the caret as false positives on the hub"/>
      <action id="CodeSonar.DisableCheck" class="com.github.jclsn.codesonar.actions.DisableCheckAction"
              text="Disable Check"
              description="Turn off the check of the warning in the line of the caret in the workspace configuration"/>
      <action id="CodeSonar.Warnings" class="com.github.jclsn.codesonar.actions.WarningsAction"
              text="Show Warnings"
              description="List the shown warnings in a tool window"/>
      <action id="CodeSonar.Status" class="com.github.jclsn.codesonar.actions.StatusAction"
              text="Status"
              description="Show the analysis, its warnings and how analyses are run"/>
      <separator/>
      <action id="CodeSonar.Analyze" class="com.github.jclsn.codesonar.actions.AnalyzeAction"
              text="Analyze"
              description="Run codesonar analyze for the workspace and show the new analysis"/>
      <action id="CodeSonar.AnalyzeAs" class="com.github.jclsn.codesonar.actions.AnalyzeAsAction"
              text="Analyze As..."
              description="Run an analysis with a name on the hub"/>
      <action id="CodeSonar.Conf" class="com.github.jclsn.codesonar.actions.ConfAction"
              text="Workspace Configuration"
              description="Open the codesonar.conf of the workspace, or start it"/>
      <action id="CodeSonar.Presets" class="com.github.jclsn.codesonar.actions.PresetsAction"
              text="Presets..."
              description="Choose the CodeSonar presets of analyses"/>
      <action id="CodeSonar.Checks" class="com.github.jclsn.codesonar.actions.ChecksAction"
              text="Checks..."
              description="Choose the checks (warning classes) of analyses"/>
      <separator/>
      <action id="CodeSonar.Connect" class="com.github.jclsn.codesonar.actions.ConnectAction"
              text="Connect to Hub..."
              description="Sign in to a hub and choose one of its projects"/>
      <action id="CodeSonar.Projects" class="com.github.jclsn.codesonar.actions.ProjectsAction"
              text="Projects..."
              description="Choose another project of the hub"/>
    </group>

    <group id="CodeSonar.ToolsMenu" text="CodeSonar" popup="true">
      <reference ref="CodeSonar.Actions"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </group>

    <group id="CodeSonar.EditorPopupMenu" text="CodeSonar" popup="true"
           class="com.github.jclsn.codesonar.actions.CodeSonarEditorGroup">
      <reference ref="CodeSonar.Actions"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </group>
  </actions>
</idea-plugin>
